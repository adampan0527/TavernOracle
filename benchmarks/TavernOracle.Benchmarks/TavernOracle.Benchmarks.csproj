<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TavernOracle\TavernOracle.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <LibDir Condition="Exists('$(MSBuildThisFileDirectory)..\..\lib')">$(MSBuildThisFileDirectory)..\..\lib</LibDir>
    <HearthDbAssembly Condition="'$(LibDir)' != '' and Exists('$(LibDir)\HearthDb.dll')">$(LibDir)\HearthDb.dll</HearthDbAssembly>
  </PropertyGroup>

  <ItemGroup Condition="'$(HearthDbAssembly)' != ''">
    <Reference Include="HearthDb">
      <HintPath>$(HearthDbAssembly)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
